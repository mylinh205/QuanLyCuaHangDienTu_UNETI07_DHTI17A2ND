@model QuanLyCuaHangDienTu_UNETI07_DHTI17A2ND.ViewModels.AdminResetPasswordVm

@{
    ViewData["Title"] = "Đặt lại mật khẩu khách hàng";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
        <div>
            <div class="text-uppercase text-success fw-semibold small">
                Quản trị cửa hàng
            </div>
            <h2 class="mb-0">Đặt lại mật khẩu</h2>
        </div>

        <a asp-controller="Admin"
           asp-action="Customers"
           class="btn btn-outline-secondary">
            Quay lại
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="alert alert-info">
                Khách hàng:
                <strong>@ViewBag.HoTen</strong>
            </div>

            <form asp-controller="KhachHang"
                  asp-action="ResetPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="MaKhachHang" type="hidden" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="MatKhauMoi"
                           class="form-label">
                        Mật khẩu mới
                    </label>

                    <input asp-for="MatKhauMoi"
                           type="password"
                           autocomplete="new-password"
                           class="form-control" />

                    <span asp-validation-for="MatKhauMoi"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="XacNhanMatKhau"
                           class="form-label">
                        Xác nhận mật khẩu mới
                    </label>

                    <input asp-for="XacNhanMatKhau"
                           type="password"
                           autocomplete="new-password"
                           class="form-control" />

                    <span asp-validation-for="XacNhanMatKhau"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-warning"
                        onclick="return confirm('Xác nhận đặt lại mật khẩu cho khách hàng?')">
                    Xác nhận đặt lại mật khẩu
                </button>

                <a asp-controller="Admin"
                   asp-action="Customers"
                   class="btn btn-secondary">
                    Hủy
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
