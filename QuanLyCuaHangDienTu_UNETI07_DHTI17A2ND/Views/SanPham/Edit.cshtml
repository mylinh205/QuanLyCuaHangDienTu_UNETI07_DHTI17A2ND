@model QuanLyCuaHangDienTu_UNETI07_DHTI17A2ND.Models.SanPham
@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-xl-9">
        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
            <div>
                <div class="text-uppercase small fw-bold text-success">Mã sản phẩm #@Model.MaSanPham</div>
                <h1 class="h3 mb-0">Sửa sản phẩm</h1>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        </div>
        <form asp-action="Edit" asp-route-id="@Model.MaSanPham" method="post" class="bg-light border rounded p-3 p-md-4">
            <input asp-for="MaSanPham" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <partial name="_ProductFields" model="Model" />
            <div class="d-flex justify-content-end gap-2 border-top mt-4 pt-3">
                <a asp-action="Index" class="btn btn-light">Hủy</a>
                <button type="submit" class="btn btn-success">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}