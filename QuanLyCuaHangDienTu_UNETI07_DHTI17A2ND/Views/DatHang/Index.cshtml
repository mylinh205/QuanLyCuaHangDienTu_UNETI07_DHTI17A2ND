@model IEnumerable<QuanLyCuaHangDienTu_UNETI07_DHTI17A2ND.Models.DonHang>

@{
    ViewData["Title"] = "Đơn hàng của tôi";
    string? trangThai = ViewBag.TrangThai as string;
}

<div class="container mt-4">
    <h2 class="mb-4">Đơn hàng của tôi</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <form asp-action="Index"
          method="get"
          class="row g-2 mb-4">

        <div class="col-md-5">
            <select name="trangThai"
                    class="form-select">

                <option value="">
                    Tất cả trạng thái
                </option>

                @foreach (var status in new[]
                {
                    "Chờ xác nhận",
                    "Đã xác nhận",
                    "Đang giao",
                    "Đã hoàn thành",
                    "Đã hủy"
                })
                {
                    if (trangThai == status)
                    {
                        <option value="@status" selected>
                            @status
                        </option>
                    }
                    else
                    {
                        <option value="@status">
                            @status
                        </option>
                    }
                }
            </select>
        </div>

        <div class="col-md-auto">
            <button type="submit"
                    class="btn btn-primary">
                Lọc đơn hàng
            </button>
        </div>

        <div class="col-md-auto">
            <a asp-action="History"
               class="btn btn-outline-success">
                Lịch sử mua hàng
            </a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Bạn chưa có đơn hàng nào.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Địa chỉ giao hàng</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MaDonHang</td>

                            <td>
                                @item.NgayDat.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>@item.DiaChiGiaoHang</td>

                            <td class="text-danger fw-bold">
                                @item.TongTien.ToString("N0") VNĐ
                            </td>

                            <td>
                                @if (item.TrangThai == "Đã hoàn thành")
                                {
                                    <span class="badge bg-success">
                                        @item.TrangThai
                                    </span>
                                }
                                else if (item.TrangThai == "Đã hủy")
                                {
                                    <span class="badge bg-danger">
                                        @item.TrangThai
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @item.TrangThai
                                    </span>
                                }
                            </td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@item.MaDonHang"
                                   class="btn btn-info btn-sm">
                                    Xem chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
