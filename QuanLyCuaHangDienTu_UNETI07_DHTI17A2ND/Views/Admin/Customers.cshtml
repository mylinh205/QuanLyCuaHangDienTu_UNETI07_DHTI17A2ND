@model IEnumerable<QuanLyCuaHangDienTu_UNETI07_DHTI17A2ND.Models.KhachHang>

@{
    ViewData["Title"] = "Quản lý khách hàng";
}

<section class="py-4">

    <!-- TIÊU ĐỀ -->
    <div class="d-flex justify-content-between align-items-end gap-3 border-bottom pb-3 mb-3">
        <div>
            <div class="text-uppercase text-success fw-semibold small">
                Quản trị cửa hàng
            </div>

            <h1 class="h2 mb-0">
                Quản lý khách hàng
            </h1>
        </div>

        <a asp-controller="Admin"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">
            Dashboard
        </a>
    </div>

    <!-- THÔNG BÁO THÀNH CÔNG -->
    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }

    <!-- THÔNG BÁO LỖI -->
    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    <!-- TÌM KIẾM KHÁCH HÀNG -->
    <form asp-controller="Admin"
          asp-action="Customers"
          method="get"
          class="row g-2 mb-3">

        <div class="col-md-9">
            <input type="text"
                   name="q"
                   value="@ViewBag.Q"
                   class="form-control"
                   placeholder="Tìm tên, email, SĐT, tên đăng nhập..." />
        </div>

        <div class="col-md-3">
            <button type="submit"
                    class="btn btn-primary">
                Tìm kiếm
            </button>

            <a asp-controller="Admin"
               asp-action="Customers"
               class="btn btn-secondary">
                Làm mới
            </a>
        </div>
    </form>

    <!-- DANH SÁCH KHÁCH HÀNG -->
    <div class="table-responsive border rounded">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">
                <tr>
                    <th>Khách hàng</th>
                    <th>Email</th>
                    <th>Số điện thoại</th>
                    <th>Tên đăng nhập</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Any())
                {
                    @foreach (var customer in Model)
                    {
                        <tr>

                            <!-- HỌ TÊN -->
                            <td>
                                @customer.HoTen
                            </td>

                            <!-- EMAIL -->
                            <td>
                                @(customer.Email ?? "—")
                            </td>

                            <!-- SỐ ĐIỆN THOẠI -->
                            <td>
                                @(customer.SoDienThoai ?? "—")
                            </td>

                            <!-- TÊN ĐĂNG NHẬP -->
                            <td>
                                @(customer.TaiKhoan?.TenDangNhap ?? "—")
                            </td>

                            <!-- TRẠNG THÁI -->
                            <td>
                                <span class="badge @(customer.TrangThai ? "bg-success" : "bg-secondary")">

                                    @(customer.TrangThai
                                        ? "Hoạt động"
                                        : "Đã khóa")

                                </span>
                            </td>

                            <!-- CÁC CHỨC NĂNG -->
                            <td class="text-end">

                                <!-- SỬA THÔNG TIN KHÁCH HÀNG -->
                                <a asp-controller="KhachHang"
                                   asp-action="AdminEdit"
                                   asp-route-id="@customer.MaKhachHang"
                                   class="btn btn-sm btn-outline-primary mb-1">

                                    Sửa thông tin

                                </a>

                                @if (customer.TaiKhoan != null)
                                {
                                    <!-- ĐẶT LẠI MẬT KHẨU -->
                                    <a asp-controller="KhachHang"
                                       asp-action="ResetPassword"
                                       asp-route-id="@customer.MaKhachHang"
                                       class="btn btn-sm btn-outline-warning mb-1">

                                        Đặt lại mật khẩu

                                    </a>

                                    <!-- KHÓA / MỞ KHÓA TÀI KHOẢN -->
                                    <form asp-controller="Admin"
                                          asp-action="ToggleCustomerStatus"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@customer.MaKhachHang" />

                                        <button type="submit"
                                                class="btn btn-sm mb-1 @(customer.TrangThai ? "btn-outline-danger" : "btn-outline-success")"
                                                onclick="return confirm('Bạn có chắc chắn muốn thay đổi trạng thái tài khoản này?')">

                                            @(customer.TrangThai
                                                ? "Khóa tài khoản"
                                                : "Mở khóa")

                                        </button>

                                    </form>
                                }

                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6"
                            class="text-center text-muted py-5">

                            Chưa có khách hàng nào đăng ký
                            hoặc không tìm thấy khách hàng phù hợp.

                        </td>
                    </tr>
                }

            </tbody>

        </table>
    </div>

</section>
