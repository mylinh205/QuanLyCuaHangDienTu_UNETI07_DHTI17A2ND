@{
    ViewData["Title"] = "Thống kê Báo cáo";
    Layout = "_Layout";
}

<!--
  Họ và tên: Vũ Thành Đạt
  Mã sinh viên: 23203100069
  Nội dung: Giao diện Thống kê báo cáo doanh thu & sản phẩm bằng LINQ
-->

<div class="container mt-4">
    <h2>Thống kê & Báo cáo doanh thu cửa hàng điện tử</h2>
    <hr />

    <div class="row">
        <!-- Thống kê sản phẩm theo loại -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-primary text-white">Thống kê số lượng sản phẩm theo loại</div>
                <div class="card-body">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Tên loại sản phẩm</th>
                                <th>Số lượng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.SanPhamTheoLoai != null)
                            {
                                @foreach (var item in ViewBag.SanPhamTheoLoai)
                                {
                                    <tr>
                                        <td>@item.TenLoai</td>
                                        <td>@item.SoLuong</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Thống kê trạng thái đơn hàng -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-success text-white">Thống kê trạng thái đơn hàng</div>
                <div class="card-body">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Trạng thái đơn hàng</th>
                                <th>Số lượng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.DonHangTheoTrangThai != null)
                            {
                                @foreach (var item in ViewBag.DonHangTheoTrangThai)
                                {
                                    <tr>
                                        <td>@item.TrangThai</td>
                                        <td>@item.SoLuong</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Doanh thu theo sản phẩm -->
    <div class="row">
        <div class="col-md-12 mb-4">
            <div class="card">
                <div class="card-header bg-warning text-dark">Top sản phẩm bán chạy & Doanh thu (Đơn đã hoàn thành)</div>
                <div class="card-body">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Tên sản phẩm</th>
                                <th>Tổng số lượng bán</th>
                                <th>Tổng doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.SoLuongBanTheoSanPham != null)
                            {
                                @foreach (var item in ViewBag.SoLuongBanTheoSanPham)
                                {
                                    <tr>
                                        <td>@item.TenSanPham</td>
                                        <td>@item.TongSoLuong</td>
                                        <td>@item.TongDoanhThu.ToString("N0") VNĐ</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>