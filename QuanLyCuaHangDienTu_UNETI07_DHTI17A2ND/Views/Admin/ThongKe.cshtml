@{
    ViewData["Title"] = "Thống kê báo cáo doanh thu";
    Layout = "_Layout";
}

<div class="container py-4">
    <h2 class="mb-4 text-primary fw-bold"><i class="bi bi-bar-chart-line"></i> Báo cáo & Thống kê kinh doanh</h2>

    <div class="row g-4">
        <!-- 1. Sản phẩm theo loại -->
        <div class="col-md-6">
            <div class="card shadow h-100">
                <div class="card-header bg-dark text-white fw-bold">Thống kê số sản phẩm theo loại</div>
                <div class="card-body">
                    <table class="table table-striped">
                        <thead><tr><th>Tên loại</th><th>Số lượng sản phẩm</th></tr></thead>
                        <tbody>
                            @foreach (var item in ViewBag.SanPhamTheoLoai)
                            {
                                <tr>
                                    <td>@item.TenLoai</td>
                                    <td class="fw-bold text-primary">@item.SoLuong</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 2. Đơn hàng theo trạng thái -->
        <div class="col-md-6">
            <div class="card shadow h-100">
                <div class="card-header bg-dark text-white fw-bold">Thống kê đơn hàng theo trạng thái</div>
                <div class="card-body">
                    <table class="table table-striped">
                        <thead><tr><th>Trạng thái</th><th>Số lượng đơn</th></tr></thead>
                        <tbody>
                            @foreach (var item in ViewBag.DonHangTheoTrangThai)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">@item.TrangThai</span></td>
                                    <td class="fw-bold text-success">@item.SoLuong</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 3. Top sản phẩm bán chạy -->
        <div class="col-md-12 mt-4">
            <div class="card shadow">
                <div class="card-header bg-primary text-white fw-bold">Top sản phẩm bán chạy nhất (Đã hoàn thành)</div>
                <div class="card-body">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Tên sản phẩm</th>
                                <th>Tổng số lượng bán</th>
                                <th>Tổng doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ViewBag.SanPhamBanChay)
                            {
                                <tr>
                                    <td class="fw-bold">@item.TenSanPham</td>
                                    <td>@item.TongSoLuongBan</td>
                                    <td class="text-danger fw-bold">@item.TongDoanhThu.ToString("N0") VNĐ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>