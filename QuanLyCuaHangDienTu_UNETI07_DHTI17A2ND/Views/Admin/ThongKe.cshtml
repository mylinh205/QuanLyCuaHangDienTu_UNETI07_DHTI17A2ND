
@model QuanLyCuaHangDienTu_UNETI07_DHTI17A2ND.ViewModels.ThongKeViewModel
@{
    ViewData["Title"] = "Báo cáo Thống kê & Doanh thu";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1"><i class="bi bi-bar-chart-fill"></i> Báo cáo Thống kê & Phân tích dữ liệu</h2>
            <p class="text-muted small mb-0">Hệ thống báo cáo thông minh dựa trên truy vấn LINQ tối ưu của Entity Framework Core.</p>
        </div>
        <button onclick="window.print()" class="btn btn-outline-primary"><i class="bi bi-printer"></i> In báo cáo</button>
    </div>

    <!-- Khối tổng quan nhanh -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm bg-success text-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1 small fw-semibold">Tổng doanh thu (Đã hoàn thành)</h6>
                        <h3 class="fw-bold mb-0">@Model.TongDoanhThuTatCa.ToString("N0") VNĐ</h3>
                    </div>
                    <i class="bi bi-cash-stack fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm bg-info text-dark p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase mb-1 small fw-semibold">Tổng số lượng sản phẩm đã bán</h6>
                        <h3 class="fw-bold mb-0">@Model.TongSoLuongDaBan.ToString("N0") sản phẩm</h3>
                    </div>
                    <i class="bi bi-bag-check-fill fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- 1. Thống kê Doanh thu theo tháng -->
        <div class="col-lg-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-bold py-3">
                    <i class="bi bi-graph-up text-primary"></i> Biểu đồ & Bảng doanh thu theo tháng (Đơn đã hoàn thành)
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Tháng/Năm</th>
                                    <th>Doanh thu thực tế</th>
                                    <th style="width: 50%;">Tỷ trọng so với tổng doanh thu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.DoanhThuTheoThang.Any())
                                {
                                    foreach (var item in Model.DoanhThuTheoThang)
                                    {
                                        var percent = Model.TongDoanhThuTatCa > 0 ? (double)(item.DoanhThu / Model.TongDoanhThuTatCa * 100) : 0;
                                        <tr>
                                            <td class="fw-bold">@item.ThangNam</td>
                                            <td class="text-success fw-bold">@item.DoanhThu.ToString("N0") VNĐ</td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress w-100" style="height: 10px;">
                                                        <div class="progress-bar bg-success" role="progressbar" style="width: @percent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;"></div>
                                                    </div>
                                                    <span class="small text-muted">@percent.ToString("0.#")%</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-3">Chưa có dữ liệu doanh thu hoàn thành.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Thống kê Top sản phẩm bán chạy -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-bold py-3">
                    <i class="bi bi-trophy text-warning"></i> Top 5 Sản phẩm bán chạy nhất
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th class="text-center">Đã bán</th>
                                    <th class="text-end">Doanh thu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.SanPhamBanChay.Any())
                                {
                                    @foreach (var sp in Model.SanPhamBanChay)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@sp.TenSanPham</td>
                                            <td class="text-center"><span class="badge bg-primary">@sp.TongSoLuongBan</span></td>
                                            <td class="text-end text-success fw-bold">@sp.TongDoanhThu.ToString("N0") đ</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-3">Chưa có dữ liệu bán hàng.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Thống kê Đơn hàng theo trạng thái -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white fw-bold py-3">
                    <i class="bi bi-pie-chart text-info"></i> Tình trạng đơn hàng hệ thống
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Trạng thái đơn hàng</th>
                                    <th class="text-center">Số lượng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.DonHangTheoTrangThai.Any())
                                {
                                    @foreach (var dt in Model.DonHangTheoTrangThai)
                                    {
                                        var badgeStyle = dt.TrangThai switch
                                        {
                                            "Chờ xác nhận" => "bg-warning text-dark",
                                            "Đã xác nhận" => "bg-info text-dark",
                                            "Đang giao" => "bg-primary",
                                            "Đã hoàn thành" => "bg-success",
                                            "Đã hủy" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                        <tr>
                                            <td><span class="badge @badgeStyle p-2">@dt.TrangThai</span></td>
                                            <td class="text-center fw-bold fs-6">@dt.SoLuongDon đơn</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="2" class="text-center text-muted py-3">Chưa có dữ liệu đơn hàng.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Thống kê sản phẩm theo loại -->
        <div class="col-lg-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white fw-bold py-3">
                    <i class="bi bi-grid-3x3-gap text-secondary"></i> Số lượng sản phẩm theo từng danh mục loại
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @if (Model.SanPhamTheoLoai.Any())
                        {
                            @foreach (var loai in Model.SanPhamTheoLoai)
                            {
                                <div class="col-md-4">
                                    <div class="p-3 border rounded-3 bg-light d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="fw-bold mb-1 text-dark">@loai.TenLoai</h6>
                                            <span class="text-muted small">Danh mục sản phẩm</span>
                                        </div>
                                        <span class="badge bg-dark fs-6 px-3 py-2">@loai.SoLuongSanPham sản phẩm</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12 text-center text-muted py-3">Chưa có dữ liệu danh mục.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>