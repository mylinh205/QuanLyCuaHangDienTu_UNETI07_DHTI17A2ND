@{
    ViewData["Title"] = "Dashboard quản trị";
}

<section class="py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 border-bottom pb-3 mb-4">
        <div>
            <div class="text-uppercase text-success fw-semibold small">Quản trị cửa hàng</div>
            <h1 class="h2 mb-0">Dashboard</h1>
        </div>
        <span class="text-muted">Xin chào, @Context.Session.GetString("HoTen")</span>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="border rounded p-3 h-100">
                <div class="text-muted small">Sản phẩm</div>
                <div class="fs-2 fw-bold">@ViewBag.ProductCount</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="border rounded p-3 h-100">
                <div class="text-muted small">Loại sản phẩm</div>
                <div class="fs-2 fw-bold">@ViewBag.CategoryCount</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="border rounded p-3 h-100">
                <div class="text-muted small">Tài khoản</div>
                <div class="fs-2 fw-bold">@ViewBag.AccountCount</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="border rounded p-3 h-100">
                <div class="text-muted small">Khách hàng</div>
                <div class="fs-2 fw-bold">@ViewBag.CustomerCount</div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="SanPham" asp-action="Index" class="btn btn-success">Quản lý sản phẩm</a>
        <a asp-controller="LoaiSanPham" asp-action="Index" class="btn btn-outline-secondary">Quản lý loại sản phẩm</a>
        <a asp-controller="Admin" asp-action="Customers" class="btn btn-outline-secondary">Quản lý khách hàng</a>
    </div>
</section>