@model QuanLyCuaHangDienTu_UNETI07_DHTI17A2ND.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<section class="account-page account-register-page">
    <div class="account-shell account-shell-register">
        <aside class="account-aside">
            <a asp-controller="Home" asp-action="Index" class="account-brand">
                <span class="account-brand-icon"><i class="bi bi-cpu-fill"></i></span>
                UNETI <span>TECH</span>
            </a>
            <div class="account-aside-content">
                <span class="account-kicker">Gia nhập UNETI</span>
                <h1>Mọi món đồ công nghệ bạn cần, trong một tài khoản.</h1>
                <p>Tạo tài khoản miễn phí để đặt hàng tiện lợi và nhận hỗ trợ nhanh chóng.</p>
                <div class="account-benefit">
                    <i class="bi bi-box-seam"></i>
                    <span>Theo dõi đơn hàng thuận tiện</span>
                </div>
                <div class="account-benefit">
                    <i class="bi bi-gift"></i>
                    <span>Cập nhật ưu đãi và sản phẩm mới</span>
                </div>
            </div>
            <div class="account-aside-footer">Thế Giới Điện Tử UNETI</div>
        </aside>

        <div class="account-form-panel">
            <div class="account-form-heading">
                <span class="account-form-icon"><i class="bi bi-person-plus"></i></span>
                <span class="account-kicker">Bắt đầu mua sắm</span>
                <h2>Tạo tài khoản</h2>
                <p>Điền thông tin bên dưới để đăng ký.</p>
            </div>

            <form asp-action="Register" method="post" class="account-form">
                <div asp-validation-summary="ModelOnly" class="text-danger account-validation"></div>
                <div class="account-field">
                    <label asp-for="HoTen" class="form-label"></label>
                    <div class="account-input-wrap">
                        <i class="bi bi-person"></i>
                        <input asp-for="HoTen" class="form-control" placeholder="Nguyễn Văn A" autocomplete="name" />
                    </div>
                    <span asp-validation-for="HoTen" class="text-danger small"></span>
                </div>

                <div class="account-form-row">
                    <div class="account-field">
                        <label asp-for="TenDangNhap" class="form-label"></label>
                        <div class="account-input-wrap">
                            <i class="bi bi-at"></i>
                            <input asp-for="TenDangNhap" class="form-control" placeholder="Tên đăng nhập" autocomplete="username" />
                        </div>
                        <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                    </div>
                    <div class="account-field">
                        <label asp-for="SoDienThoai" class="form-label"></label>
                        <div class="account-input-wrap">
                            <i class="bi bi-telephone"></i>
                            <input asp-for="SoDienThoai" class="form-control" placeholder="09xxxxxxxx" autocomplete="tel" />
                        </div>
                        <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                    </div>
                </div>

                <div class="account-field">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="account-input-wrap">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Email" type="email" class="form-control" placeholder="ban@example.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="account-form-row">
                    <div class="account-field">
                        <label asp-for="MatKhau" class="form-label"></label>
                        <div class="account-input-wrap">
                            <i class="bi bi-lock"></i>
                            <input asp-for="MatKhau" type="password" class="form-control" placeholder="Ít nhất 6 ký tự" autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="MatKhau" class="text-danger small"></span>
                    </div>
                    <div class="account-field">
                        <label asp-for="XacNhanMatKhau" class="form-label"></label>
                        <div class="account-input-wrap">
                            <i class="bi bi-lock-fill"></i>
                            <input asp-for="XacNhanMatKhau" type="password" class="form-control" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="XacNhanMatKhau" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn account-submit">
                    Hoàn tất đăng ký <i class="bi bi-arrow-right"></i>
                </button>
            </form>

            <div class="account-switch">
                Đã có tài khoản?
                <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
            </div>
            <a asp-controller="Home" asp-action="Index" class="account-back"><i class="bi bi-arrow-left"></i> Quay về trang chủ</a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
