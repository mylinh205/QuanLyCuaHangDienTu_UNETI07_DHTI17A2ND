
@{
    var vaiTro = Context.Session.GetString("VaiTro");
    var maTaiKhoan = Context.Session.GetInt32("MaTaiKhoan");
    var hoTen = Context.Session.GetString("HoTen");

    bool daDangNhap = maTaiKhoan.HasValue;
    bool isAdmin = daDangNhap && vaiTro == "Admin";
    bool isKhachHang = daDangNhap && vaiTro == "KhachHang";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Quản lý cửa hàng điện tử
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/QuanLyCuaHangDienTu_UNETI07_DHTI17A2ND.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    Cửa hàng điện tử
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <!-- MENU CHÍNH -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <!-- Trang chủ -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Trang chủ
                            </a>
                        </li>

                        <!-- Sản phẩm -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="SanPham"
                               asp-action="Index">
                                Sản phẩm
                            </a>
                        </li>

                        @if (isAdmin)
                        {
                            <!-- MENU ADMIN -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Admin"
                                   asp-action="Dashboard">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="LoaiSanPham"
                                   asp-action="Index">
                                    Loại sản phẩm
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="KhachHang"
                                   asp-action="Index">
                                    Quản lý khách hàng
                                </a>
                            </li>
                        }
                        else if (isKhachHang)
                        {
                            <!-- MENU KHÁCH HÀNG -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="KhachHang"
                                   asp-action="Profile">
                                    Hồ sơ khách hàng
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="DatHang"
                                   asp-action="Index">
                                    Đơn hàng của tôi
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="DatHang"
                                   asp-action="History">
                                    Lịch sử mua hàng
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- MENU TÀI KHOẢN -->
                    <ul class="navbar-nav ms-auto">

                        @if (daDangNhap)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-dark">
                                    Xin chào,
                                    <strong>
                                        @(string.IsNullOrWhiteSpace(hoTen)
                                            ? "Người dùng"
                                            : hoTen)
                                    </strong>
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-danger"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    Đăng xuất
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Đăng nhập
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Đăng ký
                                </a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <!-- NỘI DUNG TRANG -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Quản lý cửa hàng điện tử UNETI -
            <a asp-controller="Home"
               asp-action="Privacy">
                Chính sách
            </a>
        </div>
    </footer>

    <!-- JAVASCRIPT -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
