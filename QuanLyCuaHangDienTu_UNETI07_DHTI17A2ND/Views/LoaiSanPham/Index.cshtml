@model IEnumerable<QuanLyCuaHangDienTu_UNETI07_DHTI17A2ND.Models.LoaiSanPham>
@{
    ViewData["Title"] = "Quản lý Loại sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Danh sách Loại sản phẩm</h2>
    <a asp-action="Create" class="btn btn-success">+ Thêm loại mới</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="table-responsive">
    <table class="table table-bordered table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Mã Loại</th>
                <th>Tên Loại Sản Phẩm</th>
                <th>Mô Tả</th>
                <th>Trạng Thái</th>
                <th class="text-center" style="width: 150px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MaLoai</td>
                        <td><strong>@item.TenLoai</strong></td>
                        <td>@item.MoTa</td>
                        <td>
                            @if (item.TrangThai)
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Tạm khóa</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.MaLoai" class="btn btn-sm btn-warning">Sửa</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Chưa có dữ liệu loại sản phẩm.</td>
                </tr>
            }
        </tbody>
    </table>
</div>