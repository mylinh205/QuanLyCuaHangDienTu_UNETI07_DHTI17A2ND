@model QuanLyCuaHangDienTu_UNETI07_DHTI17A2ND.Models.LoaiSanPham
@{
    ViewData["Title"] = "Thêm loại sản phẩm";
}

<!-- Họ tên: Đào Minh Long - MSV: 23203100068 -->
<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">THÊM MỚI LOẠI SẢN PHẨM</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="TenLoai" class="form-label"></label>
                        <input asp-for="TenLoai" class="form-control" placeholder="Nhập tên loại sản phẩm (ví dụ: Laptop, Điện thoại...)" />
                        <span asp-validation-for="TenLoai" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MoTa" class="form-label"></label>
                        <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Nhập mô tả loại sản phẩm..."></textarea>
                        <span asp-validation-for="MoTa" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="TrangThai" checked />
                        <label class="form-check-label" asp-for="TrangThai">
                            Cho phép hiển thị (Hoạt động)
                        </label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
                        <button type="submit" class="btn btn-primary">Lưu thông tin</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}